<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Window background is black so the post-splash surface matches the
      dark/AMOLED Compose UI without any light frame flash.
    -->
    <style name="Theme.MemoryLights" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- System splash screen theme (Jetpack core-splashscreen). -->
    <style name="Theme.MemoryLights.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.MemoryLights</item>
    </style>
</resources>
